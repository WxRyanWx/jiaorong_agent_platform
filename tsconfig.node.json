{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/cli/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/jiaorong_src/prompts/**/*",
    "src/jiaorong_src/config/**/*",
    "src/jiaorong_src/mcp/**/*",
    "src/jiaorong_src/brand/**/*",
    "src/jiaorong_src/provider/builtinSecret.ts",
    "src/jiaorong_src/logging/**/*",
    "src/jiaorong_src/utils/skillSwitchCore.ts",
    "src/jiaorong_src/knowledgeBase/mcp/knowledgeBaseMcpConstants.ts",
    "src/jiaorong_src/api/auth/config.ts",
    "src/jiaorong_src/appHost/auth.ts",
    "src/jiaorong_src/appHost/catalog.ts",
    "src/jiaorong_src/appHost/channels.ts",
    "src/jiaorong_src/appHost/bridgeErrors.ts",
    "src/jiaorong_src/appHost/types.ts",
    "src/jiaorong_src/appHost/builtinCatalog.json",
    "src/jiaorong_src/appHost/preload.ts",
    "src/jiaorong_src/appHost/main/**/*.ts",
    "src/jiaorong_src/tools/slashMenuDisplayText.ts",
    "src/jiaorong_src/tools/toolDisplayNames.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "resolveJsonModule": true,
    "types": ["electron-vite/node"],
    "moduleResolution": "bundler",
    "paths": {
      "*": [
        "./*"
      ],
      "@/*": [
        "./src/main/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@jiaorong": [
        "./src/jiaorong_src/index.ts"
      ],
      "@jiaorong/*": [
        "./src/jiaorong_src/*"
      ]
    }
  }
}
