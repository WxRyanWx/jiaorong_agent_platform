{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/jiaorong_src/prompts/**/*",
    "src/jiaorong_src/config/**/*",
    "src/jiaorong_src/brand/**/*",
    "src/jiaorong_src/utils/skillSwitchCore.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "resolveJsonModule": false,
    "types": ["electron-vite/node"],
    "moduleResolution": "bundler",
    "paths": {
      "*": [
        "./*"
      ],
      "@/*": [
        "./src/main/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@jiaorong": [
        "./src/jiaorong_src/index.ts"
      ],
      "@jiaorong/*": [
        "./src/jiaorong_src/*"
      ]
    }
  }
}
