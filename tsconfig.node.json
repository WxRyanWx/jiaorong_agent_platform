{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/cli/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/jiaorong_src/prompts/**/*",
    "src/jiaorong_src/config/**/*",
    "src/jiaorong_src/mcp/**/*",
    "src/jiaorong_src/brand/**/*",
    "src/jiaorong_src/provider/builtinSecret.ts",
    "src/jiaorong_src/logging/**/*",
    "src/jiaorong_src/utils/skillSwitchCore.ts",
    "src/jiaorong_src/knowledgeBase/mcp/knowledgeBaseMcpConstants.ts",
    "src/jiaorong_src/api/auth/config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "resolveJsonModule": true,
    "types": ["electron-vite/node"],
    "moduleResolution": "bundler",
    "paths": {
      "*": [
        "./*"
      ],
      "@/*": [
        "./src/main/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@jiaorong": [
        "./src/jiaorong_src/index.ts"
      ],
      "@jiaorong/*": [
        "./src/jiaorong_src/*"
      ]
    }
  }
}
