{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jiaorong.ai/cli/v1/doctor.schema.json",
  "type": "object",
  "required": ["ok", "cliVersion", "protocolVersions", "checks"],
  "properties": {
    "ok": { "type": "boolean" },
    "cliVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "protocolVersions": {
      "type": "array",
      "contains": { "const": 1 },
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "status": { "enum": ["pass", "fail", "warn"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
